# Copiá este archivo como .env.local, o mejor: corré `neon env pull`, que escribe
# DATABASE_URL y DATABASE_URL_UNPOOLED de la rama vinculada (ver .neon).

# Conexión pooled (la app la usa en cada request).
DATABASE_URL=

# Conexión directa, sin pooler (drizzle-kit la usa para push y migraciones).
DATABASE_URL_UNPOOLED=

# Código que se pide una sola vez por dispositivo para entrar a la app.
ACCESS_CODE=

# Zona horaria usada para "Hoy" y para calcular la semana (opcional).
APP_TIME_ZONE=America/Argentina/Buenos_Aires
